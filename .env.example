# ============================================================================
# DAIMOND STORE - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env for local tooling or reference.
#
# DO NOT put the service_role key in frontend browser code.
# The storefront and admin app only use the anon public key and authenticate
# admin users via Supabase Auth + Row Level Security (RLS).
# ============================================================================

# Supabase Project Details
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Project Organization: daimond-store
# Project Name: diamond-store
# Region: West EU (Ireland)